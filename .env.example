# Server-side settings for the worker (copy to .env on the Linux server; never commit .env).

# ---- Supabase (Project Settings → API) -----------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SECRET key (sb_secret_... or legacy service_role). Server only: never put it in Vercel or the web app.
SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=briefings

# ---- AI summaries (Groq free tier) -----------------------------------------------
# Without a key, the built-in summarizer writes the cards and script.
GROQ_API_KEY=
# Tried in order; when one hits its daily limit the next takes over, then the built-in writer.
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# ---- Schedule ---------------------------------------------------------------------
BRIEFING_TIMEZONE=America/Toronto
# QA: 07:05 (server wakes at 07:00). Production: 06:00 with the server waking at 05:45.
BATCH_TIME=07:05
# Days of briefings to keep: 2 = today and yesterday.
KEEP_DAYS=2

# ---- Admin and notifications ------------------------------------------------------
# Comma-separated. Admins can rebuild on demand and get a push when a run has problems.
ADMIN_EMAILS=
# issues = notify the admin only when something went wrong; always = after every run.
# ADMIN_NOTIFY=issues
VAPID_SUBJECT=mailto:you@example.com

# ---- Limits -------------------------------------------------------------------------
# MAX_CUSTOM_SOURCES=15
# TTS_ENGINES=kokoro,edge
