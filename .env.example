# ---- Optional: radio-quality scripts written by Claude ----------------------
# Without a key, the built-in summarizer writes the cards and script.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ---- Schedule -----------------------------------------------------------------
# The briefing time itself is set in the app (Voice & settings). Default 06:30.
BRIEFING_TIMEZONE=America/Toronto

# ---- Security -------------------------------------------------------------------
# Set this if the app is reachable from the internet (HTTP Basic auth; any username).
APP_PASSWORD=

# ---- Storage --------------------------------------------------------------------
# DATA_DIR=./data          # database, briefings and audio
# MODEL_DIR=./data/models  # Kokoro voice model
# KEEP_DAYS=14             # how many days of briefings to keep
